---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { assetUrl, url } from "../lib/site";
import { navigation } from "../lib/navigation";
import NavIcon from "../components/NavIcon.astro";
import GlobalSearch from "../components/GlobalSearch.astro";
interface Props {
  title: string;
  summary?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  section?: string;
  headings?: { depth: number; slug: string; text: string }[];
  noindex?: boolean;
  publishedAt?: string | null;
  updatedAt?: string | null;
  breadcrumbs?: { name: string; path: string }[];
  frame?: boolean;
}
const {
  title,
  summary = "Rosariumは、立林 裕太朗が趣味で構築しているサイトです。Applied AI、自然言語、システム設計、AI数学論、実務で得た知見などを公開しています。",
  canonical,
  ogImage = "og/site.png",
  ogType = "website",
  section,
  headings = [],
  noindex = false,
  publishedAt,
  updatedAt,
  breadcrumbs = [],
  frame = true,
} = Astro.props;
const documentTitle =
  title === "Home" ? "Rosarium | 立林 裕太朗" : `${title} | Rosarium`;
const canonicalUrl = canonical?.startsWith(
  "https://nullcontroller.github.io/ai-design-foundations/",
)
  ? canonical
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : new URL(assetUrl(ogImage), Astro.site).toString();
const siteUrl = new URL(assetUrl(""), Astro.site).toString();
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const collectionSections = new Set([
  "ai-design",
  "ai-mathematics",
  "practices",
  "cases",
  "articles",
  "books",
  "series",
  "essays",
  "overview",
  "reference",
  "updates",
]);
const pageType =
  ogType === "article"
    ? "TechArticle"
    : ogType === "profile"
      ? "ProfilePage"
      : collectionSections.has(section || "")
        ? "CollectionPage"
        : "WebPage";
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const pageEntity = {
  "@type": pageType,
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: documentTitle,
  ...(ogType === "article" ? { headline: title } : {}),
  description: summary,
  inLanguage: "ja",
  isPartOf: { "@id": websiteId },
  author: { "@id": personId },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl },
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  ...(breadcrumbs.length ? { breadcrumb: { "@id": breadcrumbId } } : {}),
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl,
      name: "Rosarium",
      inLanguage: "ja",
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "立林 裕太朗",
      url: new URL(url("career"), Astro.site).toString(),
    },
    pageEntity,
    ...(breadcrumbs.length
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": breadcrumbId,
            itemListElement: breadcrumbs.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.name,
              item: item.path.startsWith("http")
                ? item.path
                : new URL(url(item.path), Astro.site).toString(),
            })),
          },
        ]
      : []),
  ],
};
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17383b" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — Rosarium`} />
    <meta property="og:site_name" content="Rosarium" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — Rosarium`} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={assetUrl("favicon.svg")} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={assetUrl("icons/favicon-32x32.png")}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={assetUrl("icons/apple-touch-icon.png")}
    />
    <link rel="manifest" href={assetUrl("site.webmanifest")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Rosarium | Articles"
      href={assetUrl("feed.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Rosarium | Articles"
      href={assetUrl("feed.json")}
    />
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      title="Rosarium"
      href={assetUrl("opensearch.xml")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
    <slot name="head" />
  </head>
  <body class:list={[section === "" && "home-page", !frame && "career-page"]}>
    <a class="skip" href="#main">
      本文へ移動
    </a>
    <header class:list={["masthead", !frame && "career-masthead"]}>
      <a class="brand" href={url()}>
        <span class="brand-name">Rosarium</span>
        <span class="brand-author">立林 裕太朗</span>
        <span class="brand-domain">Applied AI / System Architecture</span>
      </a>
      {frame ? (
        <div class="header-links">
          <nav class="header-primary" aria-label="主要ページ">
            <a
              href={url("articles")}
              aria-current={section === "articles" ? "page" : undefined}
            >
              読む
            </a>
            <a
              href={url("updates")}
              aria-current={section === "updates" ? "page" : undefined}
            >
              成長録
            </a>
            <a
              href={url("cases")}
              aria-current={section === "cases" ? "page" : undefined}
            >
              実践事例
            </a>
            <a
              href={url("career")}
              aria-current={section?.startsWith("career") ? "page" : undefined}
            >
              キャリア
            </a>
          </nav>
          <div class="header-actions">
            <GlobalSearch />
            <button id="theme" type="button" aria-label="配色を切り替える">
              配色切替
            </button>
          </div>
        </div>
      ) : (
        <nav class="career-header-links" aria-label="Rosariumへの導線">
          <a href={url()}>Rosariumへ戻る</a>
          <a href={url("cases")}>実践事例を見る</a>
        </nav>
      )}
    </header>
    <div
      class:list={[
        "shell",
        frame && "global-frame",
        !frame && "career-shell",
        frame && headings.length > 0 && "has-toc",
      ]}
    >
      {frame && (
        <aside class="sidebar" aria-label="主要ナビゲーション">
          <details open>
            <summary>ナビゲーション</summary>
            <nav>
              {navigation.map((group, i) => (
                <div class:list={["nav-group", i > 0 && "nav-divider"]}>
                  {group.map((item) => (
                    <a
                      href={url(item.path)}
                      aria-current={section === item.path ? "page" : undefined}
                    >
                      <NavIcon name={item.icon} />
                      <span class="nav-copy">
                        <span>{item.title}</span>
                        <small>{item.summary}</small>
                      </span>
                    </a>
                  ))}
                </div>
              ))}
            </nav>
          </details>
        </aside>
      )}
      <main
        id="main"
        tabindex="-1"
        data-pagefind-ignore={noindex ? true : undefined}
      >
        <slot />
      </main>
      {frame && headings.length > 0 && (
        <aside class="toc" aria-label="ページ内目次">
          <>
            <p>このページ</p>
            <ol>
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class:list={[h.depth === 3 && "sub"]}>
                    <a href={"#" + h.slug}>{h.text}</a>
                  </li>
                ))}
            </ol>
          </>
        </aside>
      )}
    </div>
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>Rosarium</strong>
        <span>学習と実務を通じて育て続ける「庭」</span>
      </div>
      <nav aria-label="フッター">
        <a href={url("articles")}>読む</a> ·{" "}
        <a href={url("updates")}>成長録</a> ·{" "}
        <a href={url("cases")}>実践事例</a> ·{" "}
        <a href={url("career")}>キャリア</a> ·{" "}
        <a href={assetUrl("feed.xml")}>RSS</a> ·{" "}
        <a href="https://github.com/nullcontroller/ai-design-foundations">
          Repository
        </a>
      </nav>
    </footer>
    <script>
      const navigationViewport = matchMedia("(max-width: 760px)");
      const syncNavigation = () =>
        document
          .querySelector(".sidebar details")
          ?.toggleAttribute("open", !navigationViewport.matches);
      syncNavigation();
      navigationViewport.addEventListener("change", syncNavigation);
      const theme = document.querySelector("#theme");
      try {
        const saved = localStorage.getItem("adf-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
      theme?.addEventListener("click", () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("adf-theme", next);
        } catch {}
        void drawDiagrams();
      });
      const figures = [
        ...document.querySelectorAll<HTMLElement>("[data-mermaid]"),
      ];
      let generation = 0;
      async function drawDiagrams() {
        if (!figures.length) return;
        const run = ++generation;
        const { default: mermaid } = await import("mermaid");
        if (run !== generation) return;
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: dark ? "dark" : "default",
        });
        for (const [i, fig] of figures.entries()) {
          try {
            const { svg } = await mermaid.render(
              "diagram-" + run + "-" + i,
              fig.dataset.mermaid || "",
            );
            if (run !== generation) return;
            fig.querySelector(".diagram-output")!.innerHTML = svg;
            fig.querySelector("details")?.removeAttribute("open");
            delete fig.dataset.error;
          } catch {
            fig.dataset.error = "true";
            fig.querySelector("details")?.setAttribute("open", "");
          }
        }
      }
      void drawDiagrams();
    </script>
  </body>
</html>
