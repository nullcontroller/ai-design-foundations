---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { sections, url } from "../lib/site";
interface Props {
  title: string;
  summary?: string;
  canonical?: string;
  section?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const {
  title,
  summary = "AIを業務システムへ組み込むための設計体系",
  canonical,
  section,
  headings = [],
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | AI Design Foundations</title>
    <link
      rel="canonical"
      href={canonical || new URL(Astro.url.pathname, Astro.site)}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へ移動
    </a>
    <header class="masthead">
      <a class="brand" href={url()}>
        AI Design Foundations<span>DESIGN KNOWLEDGE / 実務と原則</span>
      </a>
      <div class="header-links">
        <a href={url("search")}>検索</a>
        <a href={url("about")}>About</a>
        <a href={url("career")}>Career</a>
        <button id="theme" type="button" aria-label="配色を切り替える">
          配色切替
        </button>
      </div>
    </header>
    <div class="shell">
      <aside class="sidebar" aria-label="主要ナビゲーション">
        <details open>
          <summary>設計体系</summary>
          <nav>
            {sections.map(([key, name, desc]) => (
              <a
                class:list={[key === "essays" && "secondary"]}
                href={url(key)}
                aria-current={section === key ? "page" : undefined}
              >
                <span>{name}</span>
                <small>{desc}</small>
              </a>
            ))}
            <a
              href={url("articles")}
              aria-current={section === "articles" ? "page" : undefined}
            >
              <span>記事一覧</span>
              <small>技術記事・論考を横断して読む</small>
            </a>
            <a
              href={url("books")}
              aria-current={section === "books" ? "page" : undefined}
            >
              <span>Books / シリーズ</span>
              <small>章構成で読む設計原則と実務事例</small>
            </a>
          </nav>
        </details>
        <p class="sidebar-note">
          Knowledge / Publishing as Code
          <br />
          原則から実務へ。実務から設計へ。
        </p>
      </aside>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <aside class="toc" aria-label="ページ内目次">
        {headings.length > 0 && (
          <>
            <p>このページ</p>
            <ol>
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class:list={[h.depth === 3 && "sub"]}>
                    <a href={"#" + h.slug}>{h.text}</a>
                  </li>
                ))}
            </ol>
          </>
        )}
      </aside>
    </div>
    <footer class="site-footer">
      AI Design Foundations ·{" "}
      <a href="https://github.com/nullcontroller/ai-design-foundations">
        GitHub
      </a>{" "}
      · Markdownで管理する設計知識
    </footer>
    <script>
      if (matchMedia("(max-width: 760px)").matches)
        document.querySelector(".sidebar details")?.removeAttribute("open");
      const theme = document.querySelector("#theme");
      try {
        const saved = localStorage.getItem("adf-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
      theme?.addEventListener("click", () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("adf-theme", next);
        } catch {}
        void drawDiagrams();
      });
      const figures = [
        ...document.querySelectorAll<HTMLElement>("[data-mermaid]"),
      ];
      let generation = 0;
      async function drawDiagrams() {
        if (!figures.length) return;
        const run = ++generation;
        const { default: mermaid } = await import("mermaid");
        if (run !== generation) return;
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: dark ? "dark" : "default",
        });
        for (const [i, fig] of figures.entries()) {
          try {
            const { svg } = await mermaid.render(
              "diagram-" + run + "-" + i,
              fig.dataset.mermaid || "",
            );
            if (run !== generation) return;
            fig.querySelector(".diagram-output")!.innerHTML = svg;
            fig.querySelector("details")?.removeAttribute("open");
            delete fig.dataset.error;
          } catch {
            fig.dataset.error = "true";
            fig.querySelector("details")?.setAttribute("open", "");
          }
        }
      }
      void drawDiagrams();
    </script>
  </body>
</html>
