---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { url } from "../lib/site";
import { navigation } from "../lib/navigation";
interface Props {
  title: string;
  summary?: string;
  canonical?: string;
  section?: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const {
  title,
  summary = "立林 裕太朗のキャリア、AI・システム設計の知識、実務事例と記事。",
  canonical,
  section,
  headings = [],
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={summary} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | 立林 裕太朗</title>
    <link rel="canonical" href={canonical?.startsWith("https://nullcontroller.github.io/ai-design-foundations/") ? canonical : new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">
      本文へ移動
    </a>
    <header class="masthead">
      <a class="brand" href={url()}>
        立林 裕太朗<span>Applied AI / System Architecture</span>
      </a>
      <div class="header-links">
        <a href={url("overview")}>全体目次</a>
        <a href={url("search")}>検索</a>
        <a href={url("about")}>About</a>
        <a href={url("career")}>Career</a>
        <button id="theme" type="button" aria-label="配色を切り替える">
          配色切替
        </button>
      </div>
    </header>
    <div class="shell">
      <aside class="sidebar" aria-label="主要ナビゲーション">
        <details open>
          <summary>ナビゲーション</summary>
          <nav>
            {navigation.map((group, i) => (
              <div class:list={["nav-group", i > 0 && "nav-divider"]}>
                {group.map((item) => (
                  <a
                    href={url(item.path)}
                    aria-current={section === item.path ? "page" : undefined}
                  >
                    <span>{item.title}</span>
                    <small>{item.summary}</small>
                  </a>
                ))}
              </div>
            ))}
          </nav>
        </details>
      </aside>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <aside class="toc" aria-label="ページ内目次">
        {headings.length > 0 && (
          <>
            <p>このページ</p>
            <ol>
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li class:list={[h.depth === 3 && "sub"]}>
                    <a href={"#" + h.slug}>{h.text}</a>
                  </li>
                ))}
            </ol>
          </>
        )}
      </aside>
    </div>
    <footer class="site-footer">
      立林 裕太朗 · Applied AI / System Architecture
      <nav aria-label="フッター">
        <a href={url("career")}>Career</a> ·{" "}
        <a href={url("articles")}>Articles</a> ·{" "}
        <a href={url("about")}>About</a>
      </nav>
    </footer>
    <script>
      const navigationViewport = matchMedia("(max-width: 760px)");
      const syncNavigation = () =>
        document
          .querySelector(".sidebar details")
          ?.toggleAttribute("open", !navigationViewport.matches);
      syncNavigation();
      navigationViewport.addEventListener("change", syncNavigation);
      const theme = document.querySelector("#theme");
      try {
        const saved = localStorage.getItem("adf-theme");
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
      theme?.addEventListener("click", () => {
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        const next = dark ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("adf-theme", next);
        } catch {}
        void drawDiagrams();
      });
      const figures = [
        ...document.querySelectorAll<HTMLElement>("[data-mermaid]"),
      ];
      let generation = 0;
      async function drawDiagrams() {
        if (!figures.length) return;
        const run = ++generation;
        const { default: mermaid } = await import("mermaid");
        if (run !== generation) return;
        const dark =
          document.documentElement.dataset.theme === "dark" ||
          (!document.documentElement.dataset.theme &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: "strict",
          theme: dark ? "dark" : "default",
        });
        for (const [i, fig] of figures.entries()) {
          try {
            const { svg } = await mermaid.render(
              "diagram-" + run + "-" + i,
              fig.dataset.mermaid || "",
            );
            if (run !== generation) return;
            fig.querySelector(".diagram-output")!.innerHTML = svg;
            fig.querySelector("details")?.removeAttribute("open");
            delete fig.dataset.error;
          } catch {
            fig.dataset.error = "true";
            fig.querySelector("details")?.setAttribute("open", "");
          }
        }
      }
      void drawDiagrams();
    </script>
  </body>
</html>
