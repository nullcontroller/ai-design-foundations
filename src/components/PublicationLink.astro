---
import type { Entry } from "../lib/navigation";
import {
  publicationType,
  publicationTiming,
  publicationTopic,
  publicationTopics,
} from "../lib/navigation";
import { url } from "../lib/site";
import { contentUseCases } from "../lib/use-cases";
interface Props {
  entry: Entry;
  heading?: "h2" | "h3" | "p";
}
const { entry, heading: Heading = "h3" } = Astro.props;
const d = entry.data;
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
---

<div class="content-entry publication-entry" data-content-id={entry.id}>
  <p class="meta">
    {publicationType(entry)} · {publicationTopic(entry)}
  </p>
  <Heading class="content-title">
    <a href={url(entry.id)}>{d.title}</a>
  </Heading>
  <p class="content-summary">{d.summary}</p>
  {purposes.length > 0 && (
    <p class="meta publication-purpose">
      読む目的：{purposes.map((purpose) => purpose.shortTitle).join(" / ")}
    </p>
  )}
  <p class="meta publication-date">
    {timing.label}：{timing.datetime ? (
      <time datetime={timing.datetime}>{timing.value}</time>
    ) : (
      timing.value
    )}
  </p>
  <p class="tags publication-topics">
    Topics：{publicationTopics(entry).join(" / ")}
  </p>
</div>
