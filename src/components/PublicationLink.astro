---
import type { Entry } from "../lib/navigation";
import {
  publicationType,
  publicationStatus,
  publicationTiming,
} from "../lib/navigation";
import { iconForEntry } from "../lib/icons";
import { url } from "../lib/site";
import { contentUseCases } from "../lib/use-cases";
import Icon from "./Icon.astro";
interface Props {
  entry: Entry;
  heading?: "h2" | "h3" | "p";
}
const { entry, heading: Heading = "h3" } = Astro.props;
const d = entry.data;
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const publicationState = publicationStatus(entry);
---

<div class="content-entry publication-entry icon-entry" data-content-id={entry.id}>
  <Icon name={iconForEntry(entry)} size="list" />
  <div>
    <Heading class="content-title">
      <a href={url(entry.id)}>{d.title}</a>
    </Heading>
    <p class="content-summary">{d.summary}</p>
    {purposes.length > 0 && (
      <p class="meta publication-purpose publication-topics">
        {purposes.map((purpose) => purpose.shortTitle).join(" / ")}
      </p>
    )}
    <p class="meta publication-date">
      {publicationState && <span>状態：{publicationState}</span>}
      <span>{timing.label}：{timing.datetime ? (
        <time datetime={timing.datetime}>{timing.value}</time>
      ) : (
        timing.value
      )}</span>
      <span>{publicationType(entry)}</span>
    </p>
  </div>
</div>
