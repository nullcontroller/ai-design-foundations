---
import { assetUrl } from "../lib/site";

interface Props {
  name: string;
  alt: string;
  eager?: boolean;
}

const { name, alt, eager = false } = Astro.props;
---

<figure class="section-visual">
  <img
    src={assetUrl(`assets/visuals/${name}.png`)}
    alt={alt}
    width="512"
    height="512"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</figure>
