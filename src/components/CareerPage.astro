---
import { getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import MarkdownBody from "./MarkdownBody.astro";
import { url } from "../lib/site";
import { statusLabel } from "../lib/site";
import Icon from "./Icon.astro";
interface Props {
  id: "overview" | "profile";
}
const entry = await getEntry("career", Astro.props.id);
if (!entry) throw new Error("Career content missing");
const { headings } = await render(entry);
const d = entry.data;
const displayTitle =
  Astro.props.id === "overview" ? "Own Career — 立林 裕太朗" : d.title;
---

<Site
  title={displayTitle}
  summary={d.summary}
  ogImage="og/career.png"
  ogType="profile"
  section={Astro.props.id === "profile" ? "career/profile" : "career"}
  headings={headings}
  breadcrumbs={[
    { name: "Home", path: "" },
    { name: "Own Career", path: "career" },
    ...(Astro.props.id === "profile"
      ? [{ name: displayTitle, path: "career/profile" }]
      : []),
  ]}
>
  <nav class="breadcrumb">
    <a href={url()}>Home</a> / <a href={url("career")}>Own Career</a>
  </nav>
  <article data-pagefind-body>
    <div class="document-title-row">
      <Icon name="career" size="page" />
      <h1 data-pagefind-meta="title">{displayTitle}</h1>
    </div>
    <span hidden data-pagefind-meta="icon">career</span>
    <p class="lead" data-pagefind-meta="summary">
      {d.summary}
    </p>
    <p class="meta">
      <span data-pagefind-meta="category">Own Career</span> ·{" "}
      <span data-pagefind-meta="status">{statusLabel(d.status)}</span>
    </p>
    <nav class="topic-navigation" aria-label="キャリア情報">
      <a href={url("career")}>Own Career概要</a>
      <a href={url("career/profile")}>詳しい職務経歴・希望条件を見る</a>
      <a href={url("cases")}>実務事例を読む</a>
    </nav>
    <div class="prose">
      <MarkdownBody html={entry.rendered?.html || ""} />
    </div>
  </article>
</Site>
