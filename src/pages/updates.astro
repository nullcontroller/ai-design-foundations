---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const home = url();
const canonical = new URL(home, Astro.site).toString();
---

<Site
  title="庭へ統合しました"
  summary="最近の更新情報はRosariumの庭で確認できます。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${home}`} />
  <script is:inline define:vars={{ home }}>
    location.replace(home);
  </script>
  <h1>庭へ統合しました</h1>
  <p>最近の更新情報はRosariumの庭で確認できます。</p>
  <p><a href={home}>庭へ移動する</a></p>
</Site>
