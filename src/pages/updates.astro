---
import GrowthEntry from "../components/GrowthEntry.astro";
import Site from "../layouts/Site.astro";
import { recentGrowth, recentGrowthMonth } from "../data/recent-growth";
import { assetUrl } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import ActionLink from "../components/ActionLink.astro";

const groups = Object.entries(
  recentGrowth.reduce<Record<string, typeof recentGrowth>>((result, entry) => {
    const key = recentGrowthMonth(entry.date);
    (result[key] ??= []).push(entry);
    return result;
  }, {}),
);
---

<Site
  title="最近育ったもの"
  summary="Rosariumで最近追加・更新・改訂された技術知識、実務事例、AI数学論の一覧。"
  section="updates"
  breadcrumbs={[
    { name: "Home", path: "" },
    { name: "最近育ったもの", path: "updates" },
  ]}
>
  <PageHeader
    icon="updates"
    eyebrow="RECENT GROWTH"
    title="最近育ったもの"
    summary="Rosariumで新しく公開したもの、追記・改訂したものを記録しています。"
  />
  {groups.map(([month, monthEntries]) => (
    <section class="growth-month">
      <h2>{month}</h2>
      <div class="growth-list growth-history">
        {monthEntries.map((entry) => (
          <GrowthEntry entry={entry} />
        ))}
      </div>
    </section>
  ))}
  <ActionLink href={assetUrl("feed.xml")} icon="rss" label="更新をRSSで追う" />
</Site>
