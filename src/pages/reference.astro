---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ContentIndex from "../components/ContentIndex.astro";
import { publicEntry, url } from "../lib/site";
const entries = (await getCollection("pages", publicEntry)).filter(
  (e) => e.data.layer === "reference",
);
---

<Site title="Reference" section="reference">
  <h1>Reference</h1>
  <p class="lead">用語・数式の定義と、設計上参照する資料。</p>
  <ContentIndex entries={entries} />
  <p>
    <a href={url("overview")}>全体目次</a> ·{" "}
    <a href={url("search")}>用語・本文を検索</a>
  </p>
</Site>
