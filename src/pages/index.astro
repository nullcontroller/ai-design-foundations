---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ContentLink from "../components/ContentLink.astro";
import { url, publicEntry } from "../lib/site";
const all = await getCollection("pages", publicEntry);
const route = [
  ["ai-mathematics", "AI数学論", "AIがなぜそう振る舞うのか"],
  ["ai-design", "AI Design", "その性質を前提にどう設計するか"],
  ["practices", "Practices", "業務・組織・開発でどう使うか"],
  ["cases", "Case Studies", "実際にどう適用したか"],
];
const steps = [
  "業務目的",
  "AI適用判断",
  "Knowledge / Context",
  "生成",
  "検証",
  "Human Review",
  "既存システムによる確定処理",
  "運用・評価・改善",
];
---

<Site title="AIを業務システムへ組み込むための設計体系">
  <section class="hero">
    <p class="eyebrow">APPLIED AI / SYSTEM ARCHITECTURE</p>
    <h1>
      AI Design
      <br />
      Foundations
    </h1>
    <p class="lead">AIを業務システムへ組み込むための設計体系</p>
    <p>
      AI・人間・既存システムの責任境界から、Knowledge、評価、運用まで。
      <br />
      設計原則・技術知識・実務事例を、継続的に管理する場所です。
    </p>
  </section>
  <section aria-labelledby="reading-route-title">
    <h2 id="reading-route-title">理解から、設計・実践へ</h2>
    <ol class="reading-route">
      {route.map(([key, name, desc]) => (
        <li>
          <a href={url(key)}>{name}</a>
          <span>{desc}</span>
        </li>
      ))}
    </ol>
    <p>
      おすすめの流れです。AI Designから直接読み始めても構いません。
      <a href={url("start-here")}>Start Here</a>
    </p>
  </section>
  <section class="architecture-map" aria-labelledby="map-title">
    <div class="section-heading">
      <span>01 / SYSTEM VIEW</span>
      <h2 id="map-title">生成の前後まで、設計する。</h2>
    </div>
    <ol>
      {steps.map((step, i) => (
        <li>
          <span>{String(i + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
    <p>生成・検証・採否判断・確定処理を分離し、運用から次の設計へ戻します。</p>
  </section>
  <nav class="library-links" aria-label="その他の入口">
    <a href={url("articles")}>記事一覧 — Articles / Books / Essays</a>
    <a href={url("reference")}>Reference — 用語・参照資料</a>
  </nav>
  <section class="reading-path">
    <h2>全体設計から読む</h2>
    <ol class="content-index">
      {[
        "foundations/applicability-and-delegation",
        "architecture/reference-architecture",
        "evaluation-hitl/responsibility-and-hitl",
        "architecture/change-and-reevaluation",
      ].map((id) => {
        const entry = all.find((e) => e.id === id)!;
        return (
          <li>
            <ContentLink entry={entry} heading="h3" />
          </li>
        );
      })}
    </ol>
  </section>
</Site>
