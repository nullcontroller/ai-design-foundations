---
import Site from "../layouts/Site.astro";
import { getCollection } from "astro:content";
import ContentLink from "../components/ContentLink.astro";
import { publicEntry, url } from "../lib/site";
import { primaryUseCases } from "../lib/use-cases";

const all = await getCollection("pages", publicEntry);
const find = (id: string) => {
  const entry = all.find((item) => item.id === id);
  if (!entry) throw new Error(`Home content missing: ${id}`);
  return entry;
};
const featured = [
  "foundations/applicability-and-delegation",
  "knowledge-context/instruction-knowledge-evidence",
  "software-engineering/development-workflow",
].map(find);
const cases = ["cases/system-understanding", "cases/three-ai-maintenance"].map(
  find,
);
---

<Site title="Home" section="">
  <section class="hero">
    <h1>Rosarium</h1>
    <p class="lead">
      Rosariumは、立林 裕太朗がApplied
      AI・システム設計・自然言語サービスについて、実務・設計・理論から考え、育てている個人サイトです。
    </p>
    <p>
      AIをどこに使うか。人間とAIの責任をどう分けるか。自然言語と企業内Knowledge・既存システムをどうつなぐか。その考え方と実践を整理しています。
    </p>
    <a href={url("about")}>Rosariumについて詳しく →</a>
  </section>

  <section aria-labelledby="use-case-heading">
    <div class="section-heading">
      <span>START FROM YOUR QUESTION</span>
      <h2 id="use-case-heading">何を知りたいですか？</h2>
    </div>
    <div class="use-case-index">
      {primaryUseCases.map((useCase, index) => (
        <article class="use-case-entry" data-use-case={useCase.id}>
          <span class="index-number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{useCase.title}</h3>
            <p>{useCase.description}</p>
            <a href={url(useCase.path)}>ここから読む →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <span>RECOMMENDED</span>
      <h2 id="featured-heading">まず読む</h2>
    </div>
    <p>
      適用判断、Knowledge設計、開発工程への組込みから、Rosariumの考え方を短く辿ります。
    </p>
    <ul class="content-index recommended-content">
      {featured.map((entry) => (
        <li>
          <ContentLink entry={entry} heading="h3" />
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" aria-labelledby="cases-heading">
    <div class="section-heading">
      <span>CASE STUDIES</span>
      <h2 id="cases-heading">実際の事例</h2>
    </div>
    <p>設計原則を、QA / RAGと既存ソフトウェア改善へ適用した記録です。</p>
    <ul class="content-index recommended-content">
      {cases.map((entry) => (
        <li>
          <ContentLink entry={entry} heading="h3" />
        </li>
      ))}
    </ul>
    <a href={url("cases")}>Case Studiesをすべて見る →</a>
  </section>

  <section class="home-section author-introduction">
    <div class="section-heading">
      <span>AUTHOR</span>
      <h2>このサイトを書いている人</h2>
    </div>
    <p class="lead">立林 裕太朗</p>
    <p>
      Software Development、Project Management、Generative AI /
      RAGの経験を背景に、Applied AIとSystem Architectureに取り組んでいます。
    </p>
    <nav class="library-links" aria-label="著者情報">
      <a href={url("career")}>Careerを見る →</a>
      <a href={url("career/profile")}>詳細職務経歴を見る →</a>
    </nav>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <span>ABOUT</span>
      <h2>知識と思考を育てる庭</h2>
    </div>
    <p>
      Rosariumは、問いから考え方、理論、実践、知見へ進む場所です。AI Design
      Foundationsは、その中でAI Design・AI数学論・Practices・Case
      Studiesをつなぐ技術知識・設計体系です。
    </p>
    <a href={url("about")}>Rosariumについて詳しく →</a>
  </section>

  <nav class="library-links home-final-links" aria-label="すべてのコンテンツ">
    <a href={url("articles")}>目的・テーマから読む</a>
    <a href={url("overview")}>全体目次を見る</a>
    <a href={url("search")}>サイト内を検索</a>
  </nav>
</Site>
