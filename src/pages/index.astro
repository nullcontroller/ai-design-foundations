---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";
const entries = [
  [
    "career",
    "Career",
    "技術・実務経験と今後の方向性。詳細な職務経歴、希望する役割・働き方。",
  ],
  [
    "ai-design",
    "AI Design",
    "AI・人間・既存システムの責任境界から、業務システムへの組込みを設計する。",
  ],
  [
    "ai-mathematics",
    "AI数学論",
    "確率・モデル・生成条件から、AIがなぜそのように振る舞うかを理解する。",
  ],
  ["practices", "Practices", "設計原則を業務・組織・開発へ適用する。"],
  [
    "cases",
    "Case Studies",
    "Knowledge再構築・QA / RAGと、複数AIを用いたソフトウェア改善の実務事例。",
  ],
  [
    "articles",
    "Articles",
    "これまで執筆した単発記事・Book・連載・Essayを読む。",
  ],
];
---

<Site title="Home" section="">
  <section class="hero">
    <h1>立林 裕太朗</h1>
    <p class="lead">Applied AI × システム企画・アーキテクチャ</p>
    <p>
      ソフトウェア開発、プロジェクトマネジメント、生成AI / RAG、Knowledge /
      Context設計等の経験を背景に、AI・人間・既存システムを含むシステム設計に取り組んでいます。
    </p>
    <nav class="library-links" aria-label="最初の入口">
      <a href={url("career")}>キャリア概要を見る</a>
      <a href={url("overview")}>全体目次から探す</a>
    </nav>
  </section>
  <div class="document-list">
    {entries.map(([path, title, summary]) => (
      <section class="content-entry">
        <h2 class="content-title">
          <a href={url(path)}>{title}</a>
        </h2>
        <p class="content-summary">{summary}</p>
      </section>
    ))}
  </div>
  <section>
    <h2>AI Design Foundations</h2>
    <p>
      AI Design・AI数学論・Practices・Case
      Studiesを通じて、AIを業務システムへ組み込むための技術知識と設計体系を整理しています。
    </p>
    <a href={url("ai-design")}>設計知識から読む →</a>
  </section>
</Site>
