---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import ContentLink from "../components/ContentLink.astro";
import { sections, url, publicEntry } from "../lib/site";
const all = await getCollection("pages", publicEntry);
const articleCount = all.filter(
  (e) => e.data.source?.original_type === "article",
).length;
const bookCount = all.filter((e) => e.data.series && e.data.order === 0).length;
const steps = [
  "業務目的",
  "AI適用判断",
  "Knowledge / Context",
  "生成",
  "検証",
  "Human Review",
  "既存システムによる確定処理",
  "運用・評価・改善",
];
---

<Site title="AIを業務システムへ組み込むための設計体系">
  <section class="hero">
    <p class="eyebrow">APPLIED AI / SYSTEM ARCHITECTURE</p>
    <h1>
      AI Design
      <br />
      Foundations
    </h1>
    <p class="lead">AIを業務システムへ組み込むための設計体系</p>
    <p>
      AI・人間・既存システムの責任境界から、Knowledge、評価、運用まで。
      <br />
      設計原則・技術知識・実務事例を、継続的に管理する場所です。
    </p>
  </section>
  <nav class="library-links" aria-label="形式から読む">
    <a href={url("articles")}>
      記事一覧 <strong>{articleCount}本</strong>
    </a>
    <a href={url("books")}>
      Books / シリーズ <strong>{bookCount}冊</strong>
    </a>
  </nav>
  <section class="architecture-map" aria-labelledby="map-title">
    <div class="section-heading">
      <span>01 / SYSTEM VIEW</span>
      <h2 id="map-title">生成の前後まで、設計する。</h2>
    </div>
    <ol>
      {steps.map((step, i) => (
        <li>
          <span>{String(i + 1).padStart(2, "0")}</span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
    <p>生成・検証・採否判断・確定処理を分離し、運用から次の設計へ戻します。</p>
  </section>
  <section>
    <div class="section-heading">
      <span>02 / KNOWLEDGE INDEX</span>
      <h2>設計体系を読む</h2>
    </div>
    <div class="section-index">
      {sections.map(([key, name, desc], i) => (
        <a href={url(key)}>
          <span class="index-number">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{name}</h3>
            <p>{desc}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="reading-path">
    <h2>全体設計から読む</h2>
    <ol class="content-index">
      {[
        "foundations/applicability-and-delegation",
        "architecture/reference-architecture",
        "evaluation-hitl/responsibility-and-hitl",
        "architecture/change-and-reevaluation",
      ].map((id) => {
        const entry = all.find((e) => e.id === id)!;
        return (
          <li>
            <ContentLink entry={entry} heading="h3" />
          </li>
        );
      })}
    </ol>
  </section>
</Site>
