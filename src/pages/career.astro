---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";
const focus = [
  "Applied AI",
  "システム企画",
  "システムアーキテクチャ",
  "AI・人間・既存システムの責任境界",
  "Knowledge / Context",
  "AI Evaluation / Human in the Loop",
  "AI-Assisted Software Engineering",
];
const experience = [
  "C# / .NETによる業務ソフトウェア開発",
  "要件定義・要件分析",
  "プロジェクトマネジメント",
  "RAG / QA",
  "Knowledge / Context設計",
  "AI Evaluation / Human in the Loop",
  "既存システムの仕様理解・変更・改善",
];
const career = [
  "Software Engineering",
  "Project Management",
  "Generative AI / RAG",
  "Applied AI / System Architecture",
  "System Planning / IT Strategy",
];
const headings = [
  { depth: 2, slug: "profile", text: "Profile" },
  { depth: 2, slug: "overview", text: "Career Overview" },
  { depth: 2, slug: "focus", text: "Current Focus" },
  { depth: 2, slug: "experience", text: "Selected Experience" },
  { depth: 2, slug: "foundations", text: "AI Design Foundationsとの関係" },
  { depth: 2, slug: "full-profile", text: "Full Career Profile" },
];
---

<Site
  title="立林 裕太朗 | Career / Author"
  summary="AI Design Foundationsの運営者の実務経験、技術背景、現在の関心領域。"
  headings={headings}
>
  <nav class="breadcrumb">
    <a href={url()}>Home</a> / Career
  </nav>
  <h1>立林 裕太朗 | Career / Author</h1>
  <p class="lead">この設計体系を作っている人の、実務と技術の背景。</p>
  <p>
    AI Design
    Foundationsの運営者を紹介する技術プロフィールです。正式な履歴書ではありません。
  </p>
  <section aria-labelledby="profile">
    <h2 id="profile">Profile</h2>
    <p>
      <strong>立林 裕太朗</strong>
      <br />
      Applied AI × システム企画・アーキテクチャ
    </p>
  </section>
  <section aria-labelledby="overview">
    <h2 id="overview">Career Overview</h2>
    <p>
      ソフトウェア開発とプロジェクトマネジメントの経験を基盤に、生成AIの活用からシステム全体の設計へ関心を広げています。
    </p>
    <ol class="career-flow">
      {career.map((step, i) => (
        <li>
          <span class="meta">
            {i === 4 ? "今後の方向性" : i === 3 ? "現在の中心軸" : "経験の基盤"}
          </span>
          <strong>{step}</strong>
        </li>
      ))}
    </ol>
    <p>
      将来的にはIT戦略・IT企画も視野に、自社製品・自社システムの継続的な改善に関わる技術職を志向しています。
    </p>
  </section>
  <section aria-labelledby="focus">
    <h2 id="focus">Current Focus</h2>
    <ul>
      {focus.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="experience">
    <h2 id="experience">Selected Experience</h2>
    <ul>
      {experience.map((x) => (
        <li>{x}</li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="foundations">
    <h2 id="foundations">AI Design Foundationsとの関係</h2>
    <ol class="career-flow">
      {[
        "実務で得た知見",
        "設計判断を抽象化",
        "再利用可能な設計原則として整理",
        "AI Design Foundationsとして公開・運用",
      ].map((x) => (
        <li>
          <strong>{x}</strong>
        </li>
      ))}
    </ol>
    <p>
      個別の実務で判断した理由や成立条件を整理し、別の設計でも参照できる形で公開しています。実務事例と設計原則を行き来しながら、継続的に更新するための場所がAI
      Design Foundationsです。
    </p>
  </section>
  <section aria-labelledby="full-profile">
    <h2 id="full-profile">Full Career Profile</h2>
    <p>職務経歴・希望条件の詳細は、正本となる別サイトにまとめています。</p>
    <p>
      <a href="https://nullcontroller.github.io/career-profile/">
        詳しい職務経歴・希望条件を見る — Career Profile
      </a>
    </p>
  </section>
</Site>
