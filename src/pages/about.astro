---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const home = url();
const canonical = new URL(home, Astro.site).toString();
---

<Site
  title="Rosariumについて"
  summary="Rosariumの概要は庭へ統合しました。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${home}`} />
  <script is:inline define:vars={{ home }}>
    location.replace(home);
  </script>
  <h1>Rosariumについて</h1>
  <p>Rosariumの説明は庭へ統合しました。</p>
  <p><a href={home}>Rosariumの庭へ移動する</a></p>
</Site>
