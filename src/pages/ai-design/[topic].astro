---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import RelatedPublications from "../../components/RelatedPublications.astro";
import SectionVisual from "../../components/SectionVisual.astro";
import { designTopics, relatedPublications } from "../../lib/navigation";
import { publicEntry, url } from "../../lib/site";
import PageHeader from "../../components/PageHeader.astro";
import { iconForTopic } from "../../lib/icons";
export function getStaticPaths() {
  return designTopics.map(([topic, title, summary]) => ({
    params: { topic },
    props: { title, summary },
  }));
}
const { title, summary } = Astro.props;
const all = await getCollection("pages", publicEntry);
const visuals: Record<string, [string, string]> = {
  "responsibility-control": [
    "responsibility-governance",
    "責任境界と安全な制御を表すシンボル",
  ],
  "knowledge-context": [
    "knowledge-context",
    "知識とContextの接続を表すシンボル",
  ],
  "lifecycle-operations": [
    "lifecycle-roadmap",
    "継続的な運用と改善を表すシンボル",
  ],
  architecture: [
    "system-architecture",
    "複数の層と接続点から成るシステム設計のシンボル",
  ],
};
const visual = visuals[Astro.params.topic || ""];
---

<Site
  title={title}
  section="ai-design"
  summary={summary}
  ogImage="og/ai-design.png"
>
  <nav class="breadcrumb">
    <a href={url("ai-design")}>AI設計</a> / {title}
  </nav>
  <PageHeader icon={iconForTopic(Astro.params.topic)} title={title} />
  {visual && <SectionVisual name={visual[0]} alt={visual[1]} />}
  <p class="lead">{summary}</p>
  <ContentIndex
    entries={all.filter(
      (e) =>
        e.data.layer === "ai-design" &&
        e.data.design_topic === Astro.params.topic,
    )}
  />
  <RelatedPublications entries={relatedPublications(all, Astro.params.topic)} />
</Site>
