---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentIndex from "../../components/ContentIndex.astro";
import SectionVisual from "../../components/SectionVisual.astro";
import { designTopics } from "../../lib/navigation";
import { publicEntry, url } from "../../lib/site";
import PageHeader from "../../components/PageHeader.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { iconForTopic } from "../../lib/icons";
import ThemeArticleIndex from "../../components/ThemeArticleIndex.astro";
import { readingNavigation } from "../../lib/reading";
const all = await getCollection("pages", publicEntry);
const themeGroups = readingNavigation(all, "ai-design");
---

<Site
  title="AI設計"
  section="ai-design"
  ogImage="og/ai-design.png"
  themeGroups={themeGroups}
>
  <PageHeader icon="ai-design" title="AI設計" />
  <SectionVisual
    name="system-architecture"
    alt="複数の層と接続点から成るシステム設計のシンボル"
  />
  <p class="lead">AIの性質を前提として、業務システムへどう組み込むか。</p>
  <p>
    適用判断から責任境界、評価、運用までを扱う現在の設計知識です。数学の章を先に読まなくても、必要なテーマから参照できます。
  </p>
  <ThemeArticleIndex groups={themeGroups} />
  <nav class="topic-navigation" aria-label="AI設計のテーマ">
    {designTopics.map(([key, title]) => (
      <a href={url("ai-design/" + key)}>{title}</a>
    ))}
  </nav>
  {designTopics.map(([key, title, summary]) => (
    <section>
      <SectionHeading icon={iconForTopic(key)} title={title} />
      <p class="section-title-link"><a href={url("ai-design/" + key)}>このテーマを見る →</a></p>
      <p>{summary}</p>
      <ContentIndex
        entries={all.filter(
          (e) => e.data.layer === "ai-design" && e.data.design_topic === key,
        )}
      />
    </section>
  ))}
</Site>
