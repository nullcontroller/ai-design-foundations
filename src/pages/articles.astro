---
import Site from "../layouts/Site.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ActionLink from "../components/ActionLink.astro";
import { url } from "../lib/site";
import { readingCategories } from "../lib/navigation";
---

<Site title="読み物" section="articles">
  <PageHeader
    icon="articles"
    title="読み物"
    summary="Rosariumで育てている知識を、テーマごとにまとめています。"
  />

  <div class="reading-directory">
    {readingCategories.map((category) => (
      <section class="reading-area" id={category.path}>
      <SectionHeading icon={category.icon} title={category.title} />
      <p>{category.summary}</p>
      <ActionLink
        href={url(category.path)}
        icon={category.icon}
        label={category.title}
      />
    </section>
    ))}
  </div>
</Site>
