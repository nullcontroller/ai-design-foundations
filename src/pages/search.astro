---
import Site from "../layouts/Site.astro";
import { url } from "../lib/site";

const home = url();
const searchHome = `${home}?search=1`;
const canonical = new URL(home, Astro.site).toString();
---

<Site
  title="検索"
  summary="検索機能はRosarium全体のHeaderへ移動しました。"
  canonical={canonical}
  noindex
>
  <meta slot="head" http-equiv="refresh" content={`0;url=${searchHome}`} />
  <script is:inline define:vars={{ home }}>
    const current = new URL(location.href);
    const target = new URL(home, location.origin);
    target.searchParams.set("search", "1");
    const query = current.searchParams.get("q");
    if (query) target.searchParams.set("q", query);
    location.replace(target);
  </script>
  <h1>検索</h1>
  <p>検索機能はHeaderへ移動しました。</p>
  <p><a href={searchHome}>Rosariumを検索する</a></p>
</Site>
