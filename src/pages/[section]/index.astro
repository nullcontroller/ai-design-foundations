---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import ContentLink from "../../components/ContentLink.astro";
import { sections, url, publicEntry } from "../../lib/site";
export function getStaticPaths() {
  return sections.map(([section, title, summary]) => ({
    params: { section },
    props: { title, summary },
  }));
}
const { title, summary } = Astro.props;
const entries = (await getCollection("pages", publicEntry)).filter(
  (e) =>
    e.data.section === Astro.params.section &&
    (!e.data.series || e.data.order === 0),
);
---

<Site title={title} summary={summary} section={Astro.params.section}>
  <nav class="breadcrumb">
    <a href={url()}>Home</a> / {title}
  </nav>
  <h1>{title}</h1>
  <p class="lead">{summary}</p>
  {Astro.params.section === "essays" && (
    <p>
      ここでは市場・キャリア・技術への考察{entries.length}
      本を掲載しています。設計原則や実務に関する記事も含めて読む場合は、
      <a href={url("articles")}>記事一覧</a>をご覧ください。
      <a href={url("books")}>Books / シリーズ</a>も別に掲載しています。
    </p>
  )}
  <div class="document-list">
    {entries.map((e) => (
      <article>
        <ContentLink entry={e} />
        <p class="tags">{e.data.tags.join(" / ")}</p>
      </article>
    ))}
  </div>
</Site>
