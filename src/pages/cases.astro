---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import SectionVisual from "../components/SectionVisual.astro";
import { caseStudies } from "../lib/navigation";
import { publicEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
const all = await getCollection("pages", publicEntry);
---

<Site title="実践事例" section="cases">
  <PageHeader icon="cases" title="実践事例" />
  <SectionVisual
    name="practice-case-study"
    alt="実務データと知見の関係を表す実践事例のシンボル"
  />
  <p class="lead">実務での課題・設計判断・実装・結果を、2冊のBookで読む。</p>
  <p>各事例の課題、設計、結果を確認し、必要な章へ進めます。</p>
  <nav class="topic-navigation" aria-label="全体と公開物への入口">
    <a href={url("articles")}>読む</a>
    <a href={url("series")}>設計原則の連載</a>
    <a href={url("articles")}>記事一覧</a>
  </nav>
  {caseStudies.map((study) => (
    <section class="case-study-index">
      <dl class="case-outcome">
        <div>
          <dt>課題</dt>
          <dd>{study.challenge}</dd>
        </div>
        <div>
          <dt>設計</dt>
          <dd>{study.designSummary}</dd>
        </div>
        <div>
          <dt>結果</dt>
          <dd>{study.result}</dd>
        </div>
      </dl>
      <SeriesIndex entry={all.find((e) => e.id === study.book)!} all={all} />
    </section>
  ))}
</Site>
