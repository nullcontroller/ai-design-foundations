---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { caseStudies } from "../lib/navigation";
import { publicEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
import ThemeArticleIndex from "../components/ThemeArticleIndex.astro";
const all = await getCollection("pages", publicEntry);
const caseEntries = caseStudies.map((study) => {
  const entry = all.find((item) => item.id === study.book);
  if (!entry) throw new Error(`Missing case study: ${study.book}`);
  return entry;
});
const themeLinks = caseEntries.map((entry) => ({
  title: entry.data.title,
  href: url(entry.id),
}));
---

<Site title="実践事例" section="cases" themeLinks={themeLinks}>
  <PageHeader icon="cases" title="実践事例" />
  <p class="lead">実務での課題・設計判断・実装・結果を、2冊のBookで読む。</p>
  <p>各事例の課題、設計、結果を確認し、必要な章へ進めます。</p>
  <ThemeArticleIndex links={themeLinks} />
  <nav class="topic-navigation" aria-label="全体と公開物への入口">
    <a href={url("articles")}>読み物</a>
    <a href={url("series")}>設計原則の連載</a>
  </nav>
  {caseStudies.map((study) => (
    <section class="case-study-index">
      <SeriesIndex entry={all.find((e) => e.id === study.book)!} all={all} showCover={false}>
        <dl slot="details" class="case-outcome" aria-label="課題から結果まで">
          <div>
            <dt>課題</dt>
            <dd>{study.challenge}</dd>
          </div>
          <div>
            <dt>設計</dt>
            <dd>{study.designSummary}</dd>
          </div>
          <div>
            <dt>結果</dt>
            <dd>{study.result}</dd>
          </div>
        </dl>
      </SeriesIndex>
    </section>
  ))}
</Site>
