---
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
import RelatedPublications from "../components/RelatedPublications.astro";
import {
  layerPath,
  contentCategory,
  relatedPublications,
  topicLabel,
  designTopics,
  topicPublications,
  publicationType,
  publicationTiming,
  mathematicsReadingIds,
} from "../lib/navigation";
import ContentLink from "../components/ContentLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import AuthorBox from "../components/AuthorBox.astro";
import { imageDimensions } from "../lib/image-metadata";
import { contentUseCases } from "../lib/use-cases";
import { url, layerLabel, publicEntry } from "../lib/site";
import { statusLabel } from "../lib/site";
import { updateLabels, updateType } from "../lib/growth";
import { iconForEntry, iconForTopic } from "../lib/icons";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
export async function getStaticPaths() {
  return (await getCollection("pages", publicEntry)).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const d = entry.data;
const primaryPath = d.section === "cases" ? "cases" : layerPath(d.layer);
const primaryLabel =
  d.section === "cases" ? "実践事例" : layerLabel(d.layer);
const { headings } = await render(entry);
const all = await getCollection("pages", publicEntry);
const series = d.series
  ? all
      .filter((e) => e.data.series === d.series)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  : [];
const readingSequence = series.length
  ? series
  : d.layer === "ai-mathematics"
    ? mathematicsReadingIds
        .map((id) => all.find((item) => item.id === id))
        .filter((item): item is (typeof all)[number] => Boolean(item))
    : [];
const position = readingSequence.findIndex((e) => e.id === entry.id);
const previous = readingSequence[position - 1],
  next = readingSequence[position + 1];
const coverDimensions = imageDimensions(
  d.cover ? "/ai-design-foundations" + d.cover : undefined,
);
const related = all
  .filter(
    (e) =>
      e.id !== entry.id &&
      !e.data.series &&
      e.data.layer === d.layer &&
      (d.design_topic
        ? e.data.design_topic === d.design_topic
        : e.data.section === d.section),
  )
  .slice(0, 3);
const purposes = contentUseCases(entry);
const timing = publicationTiming(entry);
const growthType = updateType(entry);
---

<Site
  title={d.title}
  summary={d.summary}
  canonical={d.canonical}
  ogType="article"
  publishedAt={d.published_at}
  updatedAt={d.updated_at}
  section={primaryPath}
  headings={headings}
  breadcrumbs={[
    { name: "Home", path: "" },
    { name: primaryLabel, path: primaryPath },
    ...(d.design_topic
      ? [
          {
            name: topicLabel(d.design_topic) || d.design_topic,
            path: "ai-design/" + d.design_topic,
          },
        ]
      : []),
    { name: d.title, path: entry.id },
  ]}
>
  <nav class="breadcrumb">
    <a href={url()}>Home</a> / <a href={url(primaryPath)}>{primaryLabel}</a>
    {d.design_topic && (
      <>
        {" "}
        /{" "}
        <a href={url("ai-design/" + d.design_topic)}>
          {topicLabel(d.design_topic)}
        </a>
      </>
    )}
  </nav>
  <article data-pagefind-body>
    <header class="document-header">
      <p class="eyebrow">
        <span data-pagefind-meta="category">{contentCategory(entry)}</span> /{" "}
        <span data-pagefind-meta="layer">{layerLabel(d.layer)}</span> / {d.kind}
      </p>
      <div class="document-title-row">
        <Icon name={iconForEntry(entry)} size="page" />
        <h1 data-pagefind-meta="title">{d.title}</h1>
      </div>
      <span hidden data-pagefind-meta="icon">{iconForEntry(entry)}</span>
      {d.summary && (
        <p class="lead" data-pagefind-meta="summary">
          {d.summary}
        </p>
      )}
      <p class="meta">
        <span class="status" data-pagefind-meta="status">
          {statusLabel(d.status)}
        </span>
        {(d.publication_format || d.layer === "publication") && (
          <span>
            {timing.label}：{timing.datetime ? (
              <time datetime={timing.datetime}>{timing.value}</time>
            ) : (
              timing.value
            )}
          </span>
        )}
        {d.updated_at && (
          <span data-pagefind-meta="updated_at">
            更新：<time datetime={d.updated_at}>{d.updated_at}</time>
          </span>
        )}
        {d.updated_at && (
          <span data-pagefind-meta="update_type">{updateLabels[growthType]}</span>
        )}
      </p>
      {(d.publication_format || d.layer === "publication") && (
        <span hidden data-pagefind-meta="publication">{timing.value}</span>
      )}
      {d.update_note && (
        <p class="update-note">今回の更新：{d.update_note}</p>
      )}
      <p class="tags" data-pagefind-meta="tags">
        {d.tags.join(" / ")}
      </p>
      {purposes.length > 0 && (
        <p class="content-purpose" data-pagefind-meta="use_case">
          <span>読む目的：</span>{" "}
          {purposes.map((purpose, index) => (
            <>
              {index > 0 && " / "}
              <a href={url("articles")}>{purpose.shortTitle}</a>
            </>
          ))}
        </p>
      )}
    </header>
    {d.cover && (
      <img
        class="book-cover"
        src={"/ai-design-foundations" + d.cover}
        alt={d.title + " 表紙"}
        width={coverDimensions?.width || 180}
        height={coverDimensions?.height}
        loading="lazy"
        decoding="async"
      />
    )}
    {series.length > 0 && (
      <nav class="series" aria-label="シリーズ目次" data-pagefind-ignore>
        <p>
          <a
            href={url(
              series[0].data.publication_format === "series"
                ? "series"
                : "cases",
            )}
          >
            {publicationType(series[0])}一覧
          </a>{" "}
          / <a href={url(series[0].id)}>{d.series_title} — 全体構成</a>
        </p>
        <ol>
          {series.map((e) => (
            <li>
              <ContentLink entry={e} heading="p" current={e.id === entry.id} />
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose">
      <MarkdownBody html={entry.rendered?.html || ""} />
    </div>
  </article>
  {readingSequence.length > 0 && (
    <nav
      class="pagination"
      aria-label={series.length ? "前後の章" : "AI数学論の前後ページ"}
    >
      {previous ? (
        <div>
          <p>← 前のページ</p>
          <ContentLink entry={previous} heading="p" />
        </div>
      ) : (
        <span />
      )}
      {next && (
        <div>
          <p>次のページ →</p>
          <ContentLink entry={next} heading="p" />
        </div>
      )}
    </nav>
  )}
  {d.layer === "ai-design" && (
    <RelatedPublications entries={relatedPublications(all, d.design_topic)} />
  )}
  {d.source?.type === "zenn" && d.section === "cases" && (
    <p>
      <a href={url("cases")}>実践事例 — 適用テーマ・設計原則から読む</a>
    </p>
  )}
  {designTopics.some(([key]) =>
    topicPublications[key]?.includes(series[0]?.id || entry.id),
  ) && (
    <section>
      <SectionHeading icon="ai-design" title="関連する設計" />
      <ul class="related-design-list">
        {designTopics
          .filter(([key]) =>
            topicPublications[key]?.includes(series[0]?.id || entry.id),
          )
          .map(([key, title, summary]) => (
            <li class="icon-entry">
              <Icon name={iconForTopic(key)} size="list" />
              <p><a href={url("ai-design/" + key)}>{title}</a> — {summary}</p>
            </li>
          ))}
      </ul>
    </section>
  )}
  {related.length > 0 && (
    <section class="related">
      <SectionHeading icon="arrow" title="次に読む" />
      <ul>
        {related.map((e) => (
          <li>
            <ContentLink entry={e} heading="h3" />
          </li>
        ))}
      </ul>
    </section>
  )}
  <nav class="content-end-nav" aria-label="読み終えた後のリンク">
    <a href={url(primaryPath)}>{primaryLabel}へ戻る</a>
    <a href={url("updates")}>最近の更新を見る</a>
  </nav>
  <AuthorBox />
</Site>
