---
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import SeriesIndex from "../components/SeriesIndex.astro";
import { publicEntry, url } from "../lib/site";
import PageHeader from "../components/PageHeader.astro";
const all = await getCollection("pages", publicEntry);
---

<Site title="連載" section="articles">
  <PageHeader icon="articles" title="連載" summary="AIを業務へ組み込む設計原則を、テーマごとに読み進める。" />
  <p>
    <a href={url("articles")}>読み物</a> ·{" "}
    <a href={url("cases")}>実務事例のBook</a>
  </p>
  {all
    .filter((e) => e.data.publication_format === "series")
    .map((entry) => (
      <SeriesIndex entry={entry} all={all} />
    ))}
</Site>
